# Copier en .env pour le développement, ou définir ces variables chez l'hébergeur.

# Base MySQL : une seule adresse suffit (Railway la fournit sous le nom MYSQL_URL).
MYSQL_URL=mysql://utilisateur:motdepasse@hote:3306/caip
# … ou bien les variables séparées : MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE

# Port d'écoute (fourni automatiquement par l'hébergeur).
PORT=3000

# Mot de passe des comptes de démonstration créés au premier démarrage.
DEMO_PASSWORD=Caip2026!

# Tant qu'aucun service d'e-mail n'est branché, le lien « mot de passe oublié »
# s'affiche à l'écran. Mettre « non » pour ne l'écrire que dans les journaux.
LIEN_REINITIALISATION_A_L_ECRAN=oui

# Tests locaux sans MySQL : base SQLite intégrée à Node 22.
# DB_CLIENT=sqlite
# SQLITE_FILE=caip-dev.sqlite
